# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# 🗄️ Database: Supabase Cloud PostgreSQL / Local PostgreSQL
# For Supabase:
# 1. Go to https://supabase.com -> Project Settings -> Database
# 2. Copy "URI" under Connection string:
#    - Transaction mode / Connection Pooling (Port 6543): use for DATABASE_URL
#    - Session mode / Direct Connection (Port 5432): use for DIRECT_URL
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
